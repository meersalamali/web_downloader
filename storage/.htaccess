# This folder holds files downloaded from other websites. Treat it as untrusted.
#
# SetHandler/ForceType are used instead of "php_flag engine off" because they
# work whether or not mod_php is loaded, and cannot cause a 500 error.

Options -Indexes -ExecCGI

<FilesMatch "\.(php|phps|phtml|php3|php4|php5|php7|php8|pht|inc|cgi|pl|py|rb|asp|aspx|jsp|jspx|shtml|sh|bat|exe)$">
    SetHandler none
    ForceType text/plain
    RemoveHandler .php .phps .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .rb .asp .aspx .jsp .shtml
</FilesMatch>

# Job bookkeeping is private; only the rewritten site/ tree is meant to be browsed.
<FilesMatch "^(job|queue|res|pack)\.json$|\.jsonl$|\.dat$|^lock$">
    Require all denied
</FilesMatch>
